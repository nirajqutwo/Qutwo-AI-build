{
  "name": "@aaif/qutwo-ai-acp",
  "version": "1.57.0",
  "description": "Install and resolve the Qutwo-AI executable through npm",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaif-qutwo-ai/qutwo-ai.git"
  },
  "keywords": [
    "qutwo-ai",
    "ai",
    "agent",
    "acp",
    "binary"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "qutwo-ai": "./bin/qutwo-ai.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "tsc --noEmit",
    "format": "prettier --write src/ test/ bin/",
    "prepack": "npm run build"
  },
  "optionalDependencies": {
    "@aaif/qutwo-ai-binary-darwin-arm64": "workspace:*",
    "@aaif/qutwo-ai-binary-darwin-x64": "workspace:*",
    "@aaif/qutwo-ai-binary-linux-arm64": "workspace:*",
    "@aaif/qutwo-ai-binary-linux-x64": "workspace:*",
    "@aaif/qutwo-ai-binary-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
